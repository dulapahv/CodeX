{
  "name": "server",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 3001",
    "start": "wrangler dev --port 3001",
    "test:socket": "start-server-and-test 'wrangler dev --port 3001 --var ROOM_GRACE_MS:10000' http://localhost:3001 'jest --server=local'",
    "test:socket:remote": "jest --server=remote",
    "test:watch": "start-server-and-test 'wrangler dev --port 3001 --var ROOM_GRACE_MS:10000' http://localhost:3001 'jest --server=local --watch'",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@codex/types": "workspace:*",
    "lib0": "^0.2.119",
    "partyserver": "0.5.10",
    "partytracks": "^0.0.56",
    "y-partyserver": "2.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "partysocket": "1.3.0",
    "start-server-and-test": "^3.0.13",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.158.0",
    "ws": "^8.22.2"
  }
}
