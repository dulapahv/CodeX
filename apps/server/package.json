{
  "name": "server",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "start": "wrangler dev --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "deploy": "wrangler deploy",
    "test:socket": "start-server-and-test 'wrangler dev --port 3001 --var ROOM_GRACE_MS:10000' http://localhost:3001 'jest --server=local'",
    "test:socket:remote": "jest --server=remote",
    "test:watch": "start-server-and-test 'wrangler dev --port 3001 --var ROOM_GRACE_MS:10000' http://localhost:3001 'jest --server=local --watch'"
  },
  "dependencies": {
    "@codex/types": "workspace:*",
    "lib0": "^0.2.119",
    "partyserver": "0.5.10",
    "y-partyserver": "2.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "partysocket": "1.3.0",
    "start-server-and-test": "^2.1.5",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "wrangler": "^4.147.0",
    "ws": "^8.22.0"
  }
}
