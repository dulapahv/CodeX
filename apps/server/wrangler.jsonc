{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "routes": [{ "pattern": "codex-server.dulapahv.dev", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "ROOM_GRACE_MS": "300000"
  },
  // Realtime SFU app and TURN key for video.
  "secrets": {
    "required": [
      "SFU_APP_ID",
      "SFU_APP_TOKEN",
      "TURN_KEY_ID",
      "TURN_KEY_API_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // Every WebSocket message is its own invocation, so these would log
      // each cursor and pointer move
      "invocation_logs": false
    },
    "issues": {
      "enabled": true
    }
  }
}
