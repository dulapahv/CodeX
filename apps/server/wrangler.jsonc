{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "codex-server.dulapahv.dev", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // How long an empty room keeps its code and notes
    "ROOM_GRACE_MS": "300000"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // Every WebSocket message is its own invocation, so these would log
      // each cursor and pointer move
      "invocation_logs": false
    },
    "issues": {
      "enabled": true
    }
  }
}
