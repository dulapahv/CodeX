{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "codex-client",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_names": false,
  "routes": [
    {
      "pattern": "codex.dulapahv.dev",
      "custom_domain": true,
      "previews_enabled": false
    }
  ],
  "vars": {
    // Workaround for opennextjs/opennextjs-cloudflare#1232 (open).
    // https://github.com/opennextjs/opennextjs-cloudflare/issues/1232
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET_PROD",
      "PISTON_API_KEY",
      "BETTERSTACK_API_KEY"
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
