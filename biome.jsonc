{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/jest"
  ],
  // shadcn registry output, kept unmodified so `shadcn add --overwrite` upgrades stay clean
  "files": {
    "includes": ["!**/components/ui"]
  },
  "linter": {
    "rules": {
      "style": {
        // Project uses TypeScript enums for socket message types - too disruptive to change
        "noEnum": "off",
        // React hooks follow useCamelCase naming convention
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case", "camelCase", "PascalCase"]
          }
        }
      },
      "suspicious": {
        // @tailwind is a valid Tailwind CSS v3 directive
        "noUnknownAtRules": "off",
        // Biome's type inference misses nullable refs, env fallbacks and flags
        // set in callbacks, so every hit here was a false positive
        "noUnnecessaryConditions": "off",
        "useBaseline": {
          "level": "error",
          "options": {
            // Progressive enhancements: unsupported browsers keep the default look
            "allowProperties": ["backdrop-filter", "scrollbar-width"],
            "allowSelectors": ["selection"]
          }
        }
      },
      "performance": {
        // Some libraries (monaco-editor, Sentry) genuinely need namespace imports
        "noNamespaceImport": "off",
        // The React Compiler already memoises inline handlers
        "noJsxPropsBind": "off"
      }
    }
  },
  "css": {
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      // Cloudflare Workers runtime globals
      "includes": ["apps/server/src/**"],
      "javascript": {
        "globals": ["WebSocketPair"]
      }
    },
    {
      // Playwright has no it(), so its tests can't follow the Jest preset's
      // it() inside describe()
      "includes": ["apps/client/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTestIt": "off"
          }
        }
      }
    }
  ]
}
